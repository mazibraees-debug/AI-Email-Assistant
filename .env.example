# ---------------------------------------------------------------------------
# AI Email Assistant — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# ---- LLM provider (at least one required) ----
# Option A: OpenRouter (recommended — access to many models via one key)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Option B: OpenAI directly
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Option C: Anthropic directly
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Option D: local / self-hosted OpenAI-compatible server (Ollama, vLLM, LM Studio)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_API_KEY=not-needed

# Provider selection: openrouter | openai | anthropic | local (auto-detected if unset)
LLM_PROVIDER=
# Fallback models tried if the primary fails (comma separated)
LLM_FALLBACK_MODELS=
# Response cache TTL in seconds (set 0 to disable)
LLM_CACHE_TTL=900

# ---- Real mailbox (IMAP read / SMTP send) ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=your_16_char_app_password
SENDER_NAME=Your Name

# ---- Persistence ----
DATABASE_PATH=data/assistant.db

# ---- API security ----
API_KEY=
APP_NAME=AI Email Assistant
APP_URL=http://localhost:8501
CORS_ORIGINS=*

# ---- Worker / scheduler ----
SCHEDULER_ENABLED=true
TRIAGE_INTERVAL_MINUTES=30
DIGEST_CRON_HOUR=8
SEND_DIGEST=false
DIGEST_RECIPIENT=

# ---- Logging / privacy ----
LOG_LEVEL=INFO
DISABLE_PII_REDACTION=false
